# bbanetworking.com — public landing page. The app lives on dashboard.bbanetworking.com.
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (SSL is served directly by Apache on this host, so %{HTTPS} is reliable)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # App routes belong to the dashboard subdomain
  RewriteCond %{HTTPS} on
  RewriteRule ^(join|invite|login|forgot-password|app|admin)(/.*)?$ https://dashboard.bbanetworking.com/$1$2 [R=302,L]
  RewriteRule ^(join|invite|login|forgot-password|app|admin)(/.*)?$ http://dashboard.bbanetworking.com/$1$2 [R=302,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^assets/ - [R=404,L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://dashboard.bbanetworking.com http://dashboard.bbanetworking.com https://behold.pictures https://*.behold.pictures https://*.cdninstagram.com https://*.fbcdn.net; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' https://dashboard.bbanetworking.com http://dashboard.bbanetworking.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
